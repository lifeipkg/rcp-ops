# 本地演示用凭据模板。复制为 .env 后填值；.env 已在 .gitignore 里，不入库。
#
#   cp .env.example .env
#
# 缺任何一个变量时 docker compose 会直接报错退出，不会静默使用弱口令。
# 真实集群不用本文件：Secret 由集群侧预置，或由 ExternalSecrets / SealedSecrets 注入
# （见 k8s/02-secret.example.yaml 的说明）。

DB_PASSWORD=change-me
IAM_ADMIN_PASSWORD=change-me
IAM_OPERATOR_PASSWORD=change-me
IAM_VIEWER_PASSWORD=change-me
